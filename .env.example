# bio-observer 環境設定テンプレート
#
# 使い方:このファイルを .env にコピーして値を設定する(.env はGit管理外)。
#   cp .env.example .env
#
# 禁止事項(SECURITY.md / D-12):
# - 正確な調査地点の座標をこのファイル・リポジトリ・ログへ書かないこと
# - APIキー等の秘密情報を .env.example(テンプレート側)へ書かないこと

# ---- 保存場所(STORAGE.md のディレクトリ方針を参照)----
# すべてのデータの基準ディレクトリ(リポジトリ外の大容量ストレージを指定)
BIO_OBSERVER_DATA_ROOT=/path/to/bio-observer-data

# 以下は未設定なら DATA_ROOT 配下の既定サブディレクトリを使う
# 原データ(元動画・元音声。読み取り専用扱い)
BIO_OBSERVER_ORIGINALS_DIR=
# 派生データ(プロキシ・クリップ・スペクトログラム・サムネイル等 = DerivedAsset)
BIO_OBSERVER_DERIVED_DIR=
# モデル本体(BirdNET等。Gitへ入れない)
BIO_OBSERVER_MODELS_DIR=
# データベースファイル(SQLite)
BIO_OBSERVER_DB_PATH=
# ログ出力先
BIO_OBSERVER_LOGS_DIR=

# ---- 実行環境 ----
# FFmpeg/FFprobe のパス(未設定なら PATH から探索)
BIO_OBSERVER_FFMPEG=
BIO_OBSERVER_FFPROBE=

# 表示用タイムゾーン(DB保存はUTC。D-6)
BIO_OBSERVER_TZ=Asia/Tokyo

# ---- Google Drive自動取込(T-110)----
# 受け箱フォルダのID(URLの folders/ 以降。ここに実IDを書いた .env はGit管理外)
BIO_OBSERVER_DRIVE_INBOX_FOLDER_ID=
# 結果フォルダ(results/)を作る親フォルダID。未設定なら受け箱直下
BIO_OBSERVER_DRIVE_RESULTS_PARENT_FOLDER_ID=
# OAuthクライアント(credentials.json)とトークンの保存先(いずれもGit管理外の絶対パス)
BIO_OBSERVER_DRIVE_CREDENTIALS_FILE=
BIO_OBSERVER_DRIVE_TOKEN_FILE=
# 再試行上限・アップロード完了判定の連続確認回数
BIO_OBSERVER_DRIVE_MAX_RETRIES=3
BIO_OBSERVER_DRIVE_STABILITY_CONFIRMATIONS=2
